#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
command -v gitleaks >/dev/null 2>&1 || { echo "Install gitleaks before committing (macOS: brew install gitleaks)." >&2; exit 1; }
[ -x node_modules/.bin/lint-staged ] || { echo "Run npm ci before committing." >&2; exit 1; }
gitleaks git --pre-commit --staged --redact=100 --no-banner
node_modules/.bin/lint-staged
gitleaks git --pre-commit --staged --redact=100 --no-banner
