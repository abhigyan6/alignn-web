{
  "name": "alignn-workspace",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "generate:api": "PYTHONPATH=apps/api/src apps/api/.venv/bin/python scripts/export-openapi.py && openapi-typescript packages/api-client/openapi.json -o packages/api-client/src/schema.d.ts",
    "dev": "npm run dev --workspace @alignn/web",
    "build": "npm run build --workspace @alignn/web",
    "typecheck": "npm run typecheck --workspace @alignn/web",
    "test:e2e": "npm run test:e2e --workspace @alignn/web",
    "lint": "npm run lint --workspace @alignn/web",
    "prepare": "node scripts/install-hooks.mjs",
    "lint:staged": "lint-staged",
    "lint:js": "eslint apps/web/src apps/web/next.config.ts apps/web/playwright.config.ts apps/web/tests"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.14.0",
    "lint-staged": "^17.6.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.2"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
