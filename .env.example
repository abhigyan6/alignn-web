ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://alignn:alignn-local-only@localhost:55432/alignn
TEST_DATABASE_URL=postgresql+psycopg://alignn:alignn-local-only@localhost:55432/alignn_test
# Pools are per process. For Heroku Essential-0 use 3/2 across one API,
# one worker and one scheduler (15 maximum total, leaving 5 for maintenance).
DATABASE_POOL_SIZE=12
DATABASE_MAX_OVERFLOW=100
DATABASE_POOL_TIMEOUT=30
# Set in the Next.js build environment when the API runs on another host.
API_ORIGIN=http://127.0.0.1:8000
PUBLIC_ORIGIN=http://localhost:3000
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=hello@alignn.test
# Production SMTP credentials are supplied securely, never committed here.
# MAIL_USERNAME=
# MAIL_PASSWORD=
# Local S3-compatible development storage.
# AWS hosting uses OBJECT_DRIVER=s3, OBJECT_AUTH_MODE=iam and
# OBJECT_REGION=ap-south-1; omit endpoint/access/secret keys in IAM mode.
OBJECT_AUTH_MODE=static
OBJECT_ENDPOINT=http://localhost:9000
OBJECT_BUCKET=alignn-private
OBJECT_ACCESS_KEY=alignn-local-only
OBJECT_SECRET_KEY=alignn-local-object-secret
SCANNER_HOST=localhost
SCANNER_PORT=3310

AUTH_PROVIDER=clerk
